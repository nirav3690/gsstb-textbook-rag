# Configuration File
# API Keys (Optional - System works with local models by default)
OPENAI_API_KEY=
GEMINI_API_KEY=

# VectorDB and Models
CHROMA_PERSIST_DIR=./backend/chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
